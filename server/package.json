{
  "name": "voidcdn-server",
  "version": "0.1.0",
  "private": true,
  "description": "Void CDN gateway — VoidAuth sessions, S3/Bunny storage, quotas and retention.",
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../.env --watch src/index.ts",
    "start": "bun --env-file=../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "admin:grant": "bun --env-file=../.env src/scripts/grant-admin.ts",
    "admin:revoke": "bun --env-file=../.env src/scripts/revoke-admin.ts",
    "sweep": "bun --env-file=../.env src/scripts/sweep.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "hono": "^4.9.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "~5.9.3"
  },
  "license": "MIT"
}
