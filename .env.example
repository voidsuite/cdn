# ─── App ───────────────────────────────────────────────────────────────────────
# Public gateway port.
PORT=3007
# Public app origin. Used for OAuth redirects, CORS and secure cookies.
APP_URL=http://localhost:5180

# ─── VoidAuth (OIDC / OAuth 2.0 + PKCE) ────────────────────────────────────────
VOIDAUTH_URL=https://auth.voidsuite.cc
VOIDCDN_CLIENT_ID=voidcdn
# Copy from the VoidAuth database after seeding (see README → OAuth client).
VOIDCDN_CLIENT_SECRET=
# Scopes requested at login. The VoidAuth deployment must allow each one.
VOIDAUTH_SCOPES=openid profile email read write role

# Optional: comma-separated extra CORS origins. Defaults to APP_URL.
# ALLOWED_ORIGINS=http://localhost:5180,https://cdn.voidsuite.cc

# SQLite database + local blob root.
DATA_DIR=./data
# Elevated admin panel session lifetime in minutes.
ADMIN_SESSION_TTL_MINUTES=30
# Optional fallback: treat these VoidAuth emails as admin when the role claim
# is missing. Prefer the role claim; leave commented in production.
# CDN_ADMIN_EMAILS=you@example.com

# ─── Storage ───────────────────────────────────────────────────────────────────
# local | s3 | bunny
STORAGE_DRIVER=local
# auto | presigned | proxy — "auto" uses direct uploads when the driver supports it.
UPLOAD_MODE=auto
# Key prefix inside the bucket / storage zone.
STORAGE_PREFIX=u

# Bunny Storage (native HTTP API). Objects are served through the connected
# pull zone — set BUNNY_CDN_BASE_URL to that pull zone origin.
BUNNY_STORAGE_ENDPOINT=https://storage.bunnycdn.com
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
# Optional separate zones (e.g. a private zone with no pull zone attached).
# BUNNY_PUBLIC_STORAGE_ZONE=
# BUNNY_PRIVATE_STORAGE_ZONE=
# Pull-zone origin that serves your storage zone, e.g.:
BUNNY_CDN_BASE_URL=https://storage.void.co.im
# Enable "Token Authentication" on the pull zone, then paste the key here.
# Public/unlisted links are then signed with HMAC-SHA256.
# BUNNY_TOKEN_AUTH_KEY=

# Generic S3 / S3-compatible storage (R2, MinIO, Wasabi, AWS…).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Optional public bucket/CDN origin for read links.
S3_PUBLIC_BASE_URL=

# Local development fallback (gateway-proxied reads, no CDN).
LOCAL_STORAGE_DIR=./data/blobs

# ─── Defaults (a fresh DB also seeds these; the admin UI can override them) ────
# 1 GiB per user.
DEFAULT_QUOTA_BYTES=1073741824
# 1 GiB per single upload.
MAX_UPLOAD_BYTES=1073741824
# Bun's request-body cap for the gateway (default 8 GiB). Must stay above the
# largest per-file limit; the app still enforces quota and MAX_UPLOAD_BYTES.
MAX_REQUEST_BODY_BYTES=8589934592
# Files above 50 MiB expire automatically.
LARGE_FILE_THRESHOLD_BYTES=52428800
# 7 days.
LARGE_FILE_RETENTION_HOURS=168
# 0 = unlimited for smaller files.
DEFAULT_RETENTION_HOURS=0
# unlisted | private
DEFAULT_VISIBILITY=unlisted
BLOCKED_MIME_TYPES=image/svg+xml,text/html,application/xhtml+xml,application/javascript,text/javascript,application/x-javascript